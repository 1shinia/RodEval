{
  "version": "tts-basic-100-v1",
  "name": "TTS 基础测试文本",
  "items": [
    {
      "id": "001",
      "category": "日常短句",
      "text": "你好，欢迎使用语音合成服务。"
    },
    {
      "id": "002",
      "category": "日常短句",
      "text": "今天阳光很好，我们去公园走走吧。"
    },
    {
      "id": "003",
      "category": "日常短句",
      "text": "请稍等，我正在为你查询订单。"
    },
    {
      "id": "004",
      "category": "日常短句",
      "text": "你的包裹已送达，请及时领取。"
    },
    {
      "id": "005",
      "category": "日常短句",
      "text": "出门前记得关灯，并检查门窗。"
    },
    {
      "id": "006",
      "category": "日常短句",
      "text": "这杯茶有点烫，慢一点喝。"
    },
    {
      "id": "007",
      "category": "日常短句",
      "text": "前方路口右转，然后沿着河边直走。"
    },
    {
      "id": "008",
      "category": "日常短句",
      "text": "请把手机调成静音，会议马上开始。"
    },
    {
      "id": "009",
      "category": "日常短句",
      "text": "没关系，我们再试一次。"
    },
    {
      "id": "010",
      "category": "日常短句",
      "text": "谢谢你的提醒，我已经记下来了。"
    },
    {
      "id": "011",
      "category": "日常短句",
      "text": "外面风大，出门多穿一件衣服。"
    },
    {
      "id": "012",
      "category": "日常短句",
      "text": "如果需要帮助，请按旁边的呼叫按钮。"
    },
    {
      "id": "013",
      "category": "日常短句",
      "text": "欢迎回家，晚饭已经准备好了。"
    },
    {
      "id": "014",
      "category": "日常短句",
      "text": "请先核对收货地址，再确认订单。"
    },
    {
      "id": "015",
      "category": "日常短句",
      "text": "这本书讲得很清楚，适合初学者阅读。"
    },
    {
      "id": "016",
      "category": "日常短句",
      "text": "车门即将关闭，请不要倚靠车门。"
    },
    {
      "id": "017",
      "category": "日常短句",
      "text": "我把钥匙放在玄关的小盒子里了。"
    },
    {
      "id": "018",
      "category": "日常短句",
      "text": "明天有雨，别忘了带伞。"
    },
    {
      "id": "019",
      "category": "日常短句",
      "text": "你可以先保存草稿，稍后继续编辑。"
    },
    {
      "id": "020",
      "category": "日常短句",
      "text": "辛苦了，忙完记得休息一会儿。"
    },
    {
      "id": "021",
      "category": "数字、日期、时间与金额",
      "text": "本次活动共有128人报名，其中36人选择线上参加。"
    },
    {
      "id": "022",
      "category": "数字、日期、时间与金额",
      "text": "仓库现有1005件商品，今天又入库了208件。"
    },
    {
      "id": "023",
      "category": "数字、日期、时间与金额",
      "text": "这座城市的常住人口约为235.6万人。"
    },
    {
      "id": "024",
      "category": "数字、日期、时间与金额",
      "text": "今天的室外温度是零下8摄氏度。"
    },
    {
      "id": "025",
      "category": "数字、日期、时间与金额",
      "text": "水温升到37.5摄氏度时，请关闭加热器。"
    },
    {
      "id": "026",
      "category": "数字、日期、时间与金额",
      "text": "这段路长1.25公里，步行大约需要18分钟。"
    },
    {
      "id": "027",
      "category": "数字、日期、时间与金额",
      "text": "商品原价199元，优惠后实付159.90元。"
    },
    {
      "id": "028",
      "category": "数字、日期、时间与金额",
      "text": "本月应缴水费28.60元，电费106.35元。"
    },
    {
      "id": "029",
      "category": "数字、日期、时间与金额",
      "text": "项目预算为120万元，其中设备费用占35%。"
    },
    {
      "id": "030",
      "category": "数字、日期、时间与金额",
      "text": "测试准确率从92.4%提高到了96.8%。"
    },
    {
      "id": "031",
      "category": "数字、日期、时间与金额",
      "text": "会议定于2027年3月15日上午9点30分开始。"
    },
    {
      "id": "032",
      "category": "数字、日期、时间与金额",
      "text": "请在2028年2月29日之前完成资料更新。"
    },
    {
      "id": "033",
      "category": "数字、日期、时间与金额",
      "text": "营业时间是周一至周五，上午8点到下午6点。"
    },
    {
      "id": "034",
      "category": "数字、日期、时间与金额",
      "text": "列车将在18:05发车，请提前15分钟到达检票口。"
    },
    {
      "id": "035",
      "category": "数字、日期、时间与金额",
      "text": "本次通话时长为1小时零8分26秒。"
    },
    {
      "id": "036",
      "category": "数字、日期、时间与金额",
      "text": "请依次读出验证码中的数字：零、七、零、二、九、四。"
    },
    {
      "id": "037",
      "category": "数字、日期、时间与金额",
      "text": "请核对房间号：三号楼，十二层，零六室。"
    },
    {
      "id": "038",
      "category": "数字、日期、时间与金额",
      "text": "这瓶饮料容量为550毫升，净含量标注在瓶身侧面。"
    },
    {
      "id": "039",
      "category": "数字、日期、时间与金额",
      "text": "两种材料按3比2的比例混合后，再加入清水。"
    },
    {
      "id": "040",
      "category": "数字、日期、时间与金额",
      "text": "跑完5公里后，他又慢走了800米。"
    },
    {
      "id": "041",
      "category": "多音字与易混淆词",
      "text": "银行门口有一行人，正在等候办理业务。"
    },
    {
      "id": "042",
      "category": "多音字与易混淆词",
      "text": "重庆的这座桥很重要，维修前必须重新检查。"
    },
    {
      "id": "043",
      "category": "多音字与易混淆词",
      "text": "他答应把借来的书还给我，还说下周一起去图书馆。"
    },
    {
      "id": "044",
      "category": "多音字与易混淆词",
      "text": "这个办法很方便，便宜的工具也能派上用场。"
    },
    {
      "id": "045",
      "category": "多音字与易混淆词",
      "text": "听到这个好消息，她高兴得忍不住笑了起来。"
    },
    {
      "id": "046",
      "category": "多音字与易混淆词",
      "text": "老师教大家把小树种进土里，并介绍不同的树种。"
    },
    {
      "id": "047",
      "category": "多音字与易混淆词",
      "text": "出差结束后，他发现两份报表之间还有一些差别。"
    },
    {
      "id": "048",
      "category": "多音字与易混淆词",
      "text": "客人住了一宿，第二天清晨离开了宿舍。"
    },
    {
      "id": "049",
      "category": "多音字与易混淆词",
      "text": "我们先测量这块木板的长度，再商量怎样搬运。"
    },
    {
      "id": "050",
      "category": "多音字与易混淆词",
      "text": "他把背包放在椅背上，转身去取车票。"
    },
    {
      "id": "051",
      "category": "多音字与易混淆词",
      "text": "他系好鞋带后，又联系了负责接待的同事。"
    },
    {
      "id": "052",
      "category": "多音字与易混淆词",
      "text": "这份薄薄的说明书里，详细介绍了薄荷的种植方法。"
    },
    {
      "id": "053",
      "category": "多音字与易混淆词",
      "text": "老人咳嗽了两声，端起杯子喝了一口水。"
    },
    {
      "id": "054",
      "category": "多音字与易混淆词",
      "text": "请分清事实和解释，再核实材料是否属实。"
    },
    {
      "id": "055",
      "category": "多音字与易混淆词",
      "text": "他认真检查了机器的支架，确认没有松动的地方。"
    },
    {
      "id": "056",
      "category": "标点、问句与对话",
      "text": "你已经到车站了吗？我在东门等你。"
    },
    {
      "id": "057",
      "category": "标点、问句与对话",
      "text": "这件事，现在处理，还是明天再说？"
    },
    {
      "id": "058",
      "category": "标点、问句与对话",
      "text": "太好了！我们终于完成了这次测试。"
    },
    {
      "id": "059",
      "category": "标点、问句与对话",
      "text": "请注意：先保存文件，再关闭程序。"
    },
    {
      "id": "060",
      "category": "标点、问句与对话",
      "text": "桌上有三样东西：一本书、一支笔，还有一杯水。"
    },
    {
      "id": "061",
      "category": "标点、问句与对话",
      "text": "如果天气允许，我们就出发；如果下雨，就改到室内活动。"
    },
    {
      "id": "062",
      "category": "标点、问句与对话",
      "text": "她问：“你要喝茶，还是喝咖啡？”我说：“一杯温水就好。”"
    },
    {
      "id": "063",
      "category": "标点、问句与对话",
      "text": "“慢一点！”他喊道，“前面的路还没有修好。”"
    },
    {
      "id": "064",
      "category": "标点、问句与对话",
      "text": "我本来想说些什么……想了想，还是先听你讲完吧。"
    },
    {
      "id": "065",
      "category": "标点、问句与对话",
      "text": "这真的是最后一班车吗？请再帮我确认一下。"
    },
    {
      "id": "066",
      "category": "标点、问句与对话",
      "text": "别着急，我们先查清原因，好吗？"
    },
    {
      "id": "067",
      "category": "标点、问句与对话",
      "text": "他停了一下，轻声说：“谢谢你一直等我。”"
    },
    {
      "id": "068",
      "category": "标点、问句与对话",
      "text": "请先看第一部分（安装说明），再阅读第二部分（使用方法）。"
    },
    {
      "id": "069",
      "category": "标点、问句与对话",
      "text": "你说的“马上”，是现在出发，还是再等十分钟？"
    },
    {
      "id": "070",
      "category": "标点、问句与对话",
      "text": "好，收到。下一步，请打开设置页面。"
    },
    {
      "id": "071",
      "category": "中英混合与英文",
      "text": "请打开 Wi-Fi 设置，连接办公室的无线网络。"
    },
    {
      "id": "072",
      "category": "中英混合与英文",
      "text": "这份 PDF 文件已经导出，可以直接发送给同事。"
    },
    {
      "id": "073",
      "category": "中英混合与英文",
      "text": "点击 Save 保存草稿，再点击 Preview 查看效果。"
    },
    {
      "id": "074",
      "category": "中英混合与英文",
      "text": "今天的主题是人工智能，也就是 AI 在日常工作中的应用。"
    },
    {
      "id": "075",
      "category": "中英混合与英文",
      "text": "新版本增加了 API 调用记录，方便排查请求失败的原因。"
    },
    {
      "id": "076",
      "category": "中英混合与英文",
      "text": "请把会议名称改成 Weekly Review，并邀请项目组成员参加。"
    },
    {
      "id": "077",
      "category": "中英混合与英文",
      "text": "这段录音需要先做 ASR 转写，再核对文字内容。"
    },
    {
      "id": "078",
      "category": "中英混合与英文",
      "text": "当前任务使用 TTS 生成语音，完成后可以点击播放。"
    },
    {
      "id": "079",
      "category": "中英混合与英文",
      "text": "Hello, welcome to our speech synthesis test."
    },
    {
      "id": "080",
      "category": "中英混合与英文",
      "text": "Could you speak a little more slowly, please?"
    },
    {
      "id": "081",
      "category": "中英混合与英文",
      "text": "The next train will arrive at platform three in five minutes."
    },
    {
      "id": "082",
      "category": "中英混合与英文",
      "text": "Your order is ready. Please collect it at the front desk."
    },
    {
      "id": "083",
      "category": "中英混合与英文",
      "text": "I thought the meeting was on Thursday, not Tuesday."
    },
    {
      "id": "084",
      "category": "中英混合与英文",
      "text": "Please save your work before closing the application."
    },
    {
      "id": "085",
      "category": "中英混合与英文",
      "text": "She asked, \"Would you like tea or coffee?\" He replied, \"Water, please.\""
    },
    {
      "id": "086",
      "category": "长句与多句段落",
      "text": "为了减少高峰时段的等待时间，服务中心将从下周一开始增加两个受理窗口，请大家根据现场指引排队办理，并提前准备好所需材料。"
    },
    {
      "id": "087",
      "category": "长句与多句段落",
      "text": "清晨的公园还很安静，湖面上浮着一层淡淡的薄雾。几位老人沿着步道慢慢散步，远处偶尔传来鸟叫声，让人不由自主地放慢脚步。"
    },
    {
      "id": "088",
      "category": "长句与多句段落",
      "text": "如果你在使用过程中遇到问题，请先确认网络连接是否正常，再检查输入内容是否完整；如果仍然无法解决，可以保存错误信息，并联系工作人员协助处理。"
    },
    {
      "id": "089",
      "category": "长句与多句段落",
      "text": "这次升级主要改善了页面加载速度和任务结果展示。原来需要反复切换页面才能查看的信息，现在可以在同一个位置找到，操作步骤也更加清楚。"
    },
    {
      "id": "090",
      "category": "长句与多句段落",
      "text": "旅客朋友们，前往南方的列车即将开始检票。请携带好随身物品，按照车票上的车厢号有序进站，照顾好同行的老人和儿童，切勿在站台边缘停留。"
    },
    {
      "id": "091",
      "category": "长句与多句段落",
      "text": "做一道菜，不一定要用复杂的调料。先把食材洗净，控制好火候，再根据口味慢慢调整，往往就能做出让家人喜欢的味道。"
    },
    {
      "id": "092",
      "category": "长句与多句段落",
      "text": "我们比较两种方案时，不仅要看第一次运行的速度，还要考虑长时间使用是否稳定、出现故障后是否容易定位，以及后续维护需要投入多少时间。"
    },
    {
      "id": "093",
      "category": "长句与多句段落",
      "text": "下午的雨渐渐停了，街边的小店重新打开了门。她收起雨伞，走进熟悉的面包店，买了一份刚出炉的点心，准备带回去和朋友一起分享。"
    },
    {
      "id": "094",
      "category": "长句与多句段落",
      "text": "请先阅读操作说明，再连接设备。连接完成后，观察指示灯是否正常；如果出现持续闪烁或异常声音，请立即停止操作，并按照说明进行检查。"
    },
    {
      "id": "095",
      "category": "长句与多句段落",
      "text": "对于需要长期保存的资料，建议同时保留原始文件和整理后的版本，并注明来源、更新时间和用途，以便其他人接手时能够理解内容，也方便以后追溯修改。"
    },
    {
      "id": "096",
      "category": "长句与多句段落",
      "text": "他原本打算坐公交车去看展览，后来发现天气不错，便改成骑车出发。沿途经过河岸、市场和一片新建的街区，虽然花的时间稍长，心情却轻松了许多。"
    },
    {
      "id": "097",
      "category": "长句与多句段落",
      "text": "在宣布测试完成之前，我们需要逐项核对输入、输出和错误记录。某一次请求成功，只能说明当时的链路可用，不能代替对不同场景和异常情况的检查。"
    },
    {
      "id": "098",
      "category": "长句与多句段落",
      "text": "欢迎参加今天的线上培训。我们会先介绍基本操作，再演示常见问题的处理方法，最后留出时间回答大家的提问；如果中途断线，可以重新进入会议继续观看。"
    },
    {
      "id": "099",
      "category": "长句与多句段落",
      "text": "当一个句子包含数字、英文和较长的修饰语时，朗读既要保持内容完整，也要在合适的位置停顿。速度过快容易让人听不清，停顿过多又会打断理解。"
    },
    {
      "id": "100",
      "category": "长句与多句段落",
      "text": "夜深了，窗外的车流渐渐稀少。她检查完最后一份文件，给同事留下一条简短的说明，然后关上电脑。明天还有新的任务，但今晚，终于可以安心休息了。"
    }
  ]
}
